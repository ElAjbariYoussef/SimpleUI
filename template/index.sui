<sui>
    <head>
        <window state="normal"
                title="SimpleUI Layout Test"
                width="900"
                height="640" />
        <link href="/assets/style.css" rel="stylesheet" />
    </head>
    <body>
        <div id="root" class="content">
            <h1>SimpleUI layout</h1>
            <p>This paragraph wraps across several lines so the inline formatter
               has to measure real glyph advances instead of guessing at
               character widths. The quick brown fox jumps over the lazy dog.</p>
            <div class="sidebar">
                <p>Nested container content</p>
                <p class="counter">12345</p>
            </div>
            <p>Line after the nested container.<br />Second line via br.</p>
        </div>
    </body>
</sui>
